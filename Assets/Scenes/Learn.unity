--- !u!114 &96841945
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 96841943}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 306eb4c557e0ab14ca9a7dff5f6686c6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textList:
  - "\u4F60\u597D"
  - "\u4F5C\u4E3A\u4E00\u540D\u5E7F\u5916\u597D\u5B66\u751F\uFF0C\u60F3\u5FC5\u4F60\u5F88\u60F3\u4E3A\u5E7F\u5916\u5EFA\u8BBE\u51FA\u4E00\u4EFD\u529B\u5427"
  - "\u592A\u597D\u4E86\uFF0C\u73B0\u5728\u6211\u6765\u4ECB\u7ECD\u4E00\u4E0B\u600E\u4E48\u9020\u5427"
  - "\u9996\u5148\uFF0C\u4F60\u7684\u5DE6\u8FB9\u662F\u5EFA\u7B51\u6750\u6599"
  - "\u90A3\u4E2A\u7EFF\u65D7\u662F\u4F60\u7684\u8D77\u70B9\uFF0C\u8981\u5148\u653E\u7F6E\u7EFF\u65D7\u624D\u80FD\u5F00\u59CB\u5594"
  - "\u5148\u70B9\u51FB\u5DE6\u952E\u653E\u7F6E\u7EFF\u65D7\u5427"
  - "\u518D\u653E\u4E00\u4E2A\u65B9\u5757\uFF0C\u5C06\u201C\u8349\u5730\u201D\u65B9\u5757\u653E\u7F6E\u5230\u7EFF\u65D7\u4E0B\u9762\uFF0C\u5982\u679C\u653E\u9519\u4E86\uFF0C\u53EF\u4EE5\u5BF9\u65B9\u5757\u53F3\u952E\u9500\u6BC1\u5594"
  - "\u975E\u5E38\u597D\uFF0C\u987A\u4FBF\u4E00\u63D0\uFF0Co\u952E\u53EF\u4EE5\u7FFB\u8F6C\u65B9\u5757\u671D\u5411\u54E6"
  - "\u5982\u679C\u5EFA\u9020\u7684\u592A\u8FDC\u770B\u4E0D\u5230\u7684\u8BDD\uFF0C\u6309\u4F4Falt\u952E\u53EF\u4EE5\u79FB\u52A8\u89C6\u89D2"
  - "\u63A5\u4E0B\u6765\uFF0C\u6211\u4E3A\u4F60\u51C6\u5907\u4E86\u4E00\u4E2A\u5730\u56FE"
  - "\u7528\u8FD9\u4E2A\u5730\u56FE\uFF0C\u6211\u4EEC\u6765\u5B66\u4E60\u4E00\u4E0B\u79FB\u52A8\u64CD\u4F5C\u5427"
  - "\u70B9\u51FB\u201C\u542F\u52A8\u201D\u8FDB\u5165\u6E38\u620F"
  - "\u6D3B\u52A8\u6D3B\u52A8\u7B4B\u9AA8\uFF0C\u6309\u4F4FD\u952E\u5F80\u524D\u8D70\u8D70\uFF01"
  - "\u6D3B\u52A8\u6D3B\u52A8\u7B4B\u9AA8\uFF0C\u6309\u4F4FA\u952E\u5F80\u540E\u8D70\u8D70\uFF01"
  - "\u975E\u5E38\u68D2\u3002\u4F46\u662F\u524D\u9762\u6709\u4E00\u5835\u5899\uFF0C\u6309\u4E0B\u7A7A\u683C\u952E\u8DF3\u8FC7\u53BB\u5427!"
  - "\u524D\u9762\u8FD8\u6709\u4E00\u5835\u66F4\u9AD8\u7684\u5899\uFF0C\u5728\u7A7A\u4E2D\u6309\u4E0B\u7A7A\u683C\u8DF3\u7684\u66F4\u9AD8\u5594"
  - "\u524D\u9762\u7684\u5751\u592A\u5927\u4E86\uFF0C\u8D76\u7D27\u56DE\u53BB\u4FEE\u8865\u4E0B\uFF0C\u5355\u51FB\u201C\u505C\u6B62\u201D\u56DE\u5230\u5EFA\u7B51\u6A21\u5F0F"
  - "\u8BA9\u6211\u4EEC\u518D\u6765\u4E00\u6B21\u5427\uFF0C\u52A0\u6CB9"
  - "\u524D\u9762\u662F\u68C0\u67E5\u70B9\uFF0C\u6309\u4E0Be\u5C31\u53EF\u4EE5\u5B58\u6863"
  - "\u524D\u9762\u6709\u4E00\u4E2A\u4F1A\u55B7\u6C34\u7684\u77F3\u5757\uFF0C\u8E29\u4E0A\u53BB\u4F1A\u8BA9\u4F60\u98DE\u4E0A\u5929\uFF0C\u4F46\u4F60\u4E5F\u4F1A\u53D7\u4F24"
  - "\u4E3A\u4E86\u5230\u8FBE\u5BF9\u9762\uFF0C\u4F60\u4F1A\u600E\u4E48\u505A\u5462"
  - "\u7EC8\u4E8E\u5230\u5BF9\u9762\u4E86\uFF0C\u4F46\u662F\u524D\u9762\u662F\u8D85\u7EA7\u591A\u7684\u677F\u6761\u7BB1\uFF0C\u4E00\u4E2A\u4E00\u4E2A\u8DF3\u8FC7\u53BB\u5427\uFF0C\u5C0F\u5FC3\u88AB\u7529\u4E0B\u53BB"
  - "\u606D\u559C\u4F60\uFF01\u4F60\u5DF2\u7ECF\u5B66\u4F1A\u4E86\u6240\u6709\u57FA\u672C\u64CD\u4F5C\u4E86\uFF01\u63A5\u4E0B\u6765\uFF0C\u8F6E\u5230\u4F60\u81EA\u5DF1\u4E86\uFF01"
  abtextList:
